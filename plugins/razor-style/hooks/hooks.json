{
  "description": "razor-style: tell every session and subagent to load the personal style skills next to Razor's",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject.mjs\"" }]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject.mjs\"" }]
      }
    ]
  }
}
